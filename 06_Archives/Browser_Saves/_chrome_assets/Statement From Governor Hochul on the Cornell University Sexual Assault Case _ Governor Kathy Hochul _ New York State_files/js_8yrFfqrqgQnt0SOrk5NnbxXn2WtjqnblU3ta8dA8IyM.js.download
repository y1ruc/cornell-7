.remove(close);classList.add(open);}else{classList.add(close);classList.remove(open);}},setMenuClicks:function(){const {menuIcons,mobileMenu}=Drupal.behaviors.navigatorSidebar.navClasses;const menu=document.querySelectorAll(menuIcons);const sidebar=document.querySelector(mobileMenu);if(typeof menu=="undefined"||menu==null)return;if(typeof sidebar=="undefined"||sidebar==null)return;for(const el of menu)el.addEventListener("click",({target})=>{if(target==null)return;Drupal.behaviors.navigatorSidebar.mobileMenuToggle(sidebar);});},setMobileActive:function(elementId){const {mobileMenuLinks,mobileMenu}=Drupal.behaviors.navigatorSidebar.navClasses;const sidebar=document.querySelector(mobileMenu);if(typeof sidebar=="undefined"||sidebar==null)return;const links=sidebar.querySelectorAll(mobileMenuLinks);for(let el of links)if(el.classList.contains(elementId)){el.parentElement.classList.add("active");el.setAttribute("aria-current","true");}else{el.parentElement.classList.remove("active");el.removeAttribute("aria-current","true");}},setupSectionsWaypoints:function(callback){const {contentTopWaypoint,contentBottomWaypoint}=Drupal.behaviors.navigatorSidebar.navClasses;const sectionsTopWaypoints=document.querySelectorAll(contentTopWaypoint);for(const el of sectionsTopWaypoints)new Waypoint({element:el,handler:function(direction){if(direction==="down")callback(this.element.dataset.id);},offset:100});const sectionsBottomWaypoints=document.querySelectorAll(contentBottomWaypoint);for(const el of sectionsBottomWaypoints)new Waypoint({element:el,handler:function(direction){if(direction==="up")callback(this.element.dataset.id);},offset:100});},setMobileMenuLinksClicks:function(){const {mobileMenuLinks,mobileMenu}=Drupal.behaviors.navigatorSidebar.navClasses;const links=document.querySelectorAll(mobileMenuLinks);const sidebar=document.querySelector(mobileMenu);for(const link of links)link.addEventListener("click",(event)=>{event.preventDefault();Drupal.behaviors.navigatorSidebar.mobileMenuToggle(sidebar);let element=document.querySelector(".t-navigator__innerContent");if(element.classList.contains('-showMenu'))setTimeout(()=>{$(link.hash).focus();$("html,body").animate({scrollTop:($(link.hash).offset().top-120)+50});},100);else{$(link.hash).focus();$("html,body").animate({scrollTop:($(link.hash).offset().top-80)});Waypoint.refreshAll();}});},desktopLinksClicks:function(){const {sidebarLinks,nextSectionBottom,nextSectionContinue}=Drupal.behaviors.navigatorSidebar.navClasses;const {desktopLinkClick}=Drupal.behaviors.navigatorSidebar;desktopLinkClick(document.querySelectorAll(sidebarLinks));desktopLinkClick(document.querySelectorAll(nextSectionBottom));desktopLinkClick(document.querySelectorAll(nextSectionContinue));},desktopLinkClick:function(links){for(const link of links)link.addEventListener("click",(event)=>{event.preventDefault();$("html, body").animate({scrollTop:$(link.hash).offset().top-50},function(){$(link.hash).focus();});});},sidebarWaypoint:function(){const {contentArea,sidebarDesktop}=Drupal.behaviors.navigatorSidebar.navClasses;const sidebar=document.querySelector(contentArea);new Waypoint({element:document.querySelector(sidebarDesktop),handler:function(direction){if(direction=="down"){sidebar.classList.add("sticky");this.element.classList.add("scrolling-down");this.element.classList.remove("scrolling-up");}else{sidebar.classList.remove("sticky");this.element.classList.remove("scrolling-down");this.element.classList.add("scrolling-up");}},offset:50});},setDesktopActive:function(elementId){const {sidebarDesktop,sidebarLinks}=Drupal.behaviors.navigatorSidebar.navClasses;const {isInViewPort}=Drupal.behaviors.navigatorSidebar;const sidebar=document.querySelector(sidebarDesktop);if(typeof sidebar=="undefined"||sidebar==null)return;const links=sidebar.querySelectorAll(sidebarLinks);const midpointActual=links.length/2;const midpointRounded=parseInt(midpointActual.toFixed(0));const sidebarContent=$('.t-navigator__content',sidebar);links.forEach((el,index)=>{if(el.classList.contains(elementId)){el.parentElement.classList.add("active");el.setAttribute("aria-current","true");if(index>=midpointRounded&&!isInViewPort(el.parentElement)){if(!sidebarContent.hasClass('midpoint-active')){const parentElementPos=$(links[midpointRounded].parentElement).position();sidebarContent.css({top:`-${parentElementPos.top-50}px`});sidebarContent.addClass('midpoint-active');}}else{if(index<midpointRounded&&!isInViewPort(el.parentElement)&&sidebarContent.hasClass('midpoint-active')){sidebarContent.css({top:`116px`});sidebarContent.removeClass('midpoint-active');}}}else{el.parentElement.classList.remove("active");el.removeAttribute("aria-current","true");}});},fadeInNextSection:function(){const {nextSection,nextSectionStopper,nextSectionDividerContent}=Drupal.behaviors.navigatorSidebar.navClasses;const nextSections=document.querySelectorAll(nextSection);const nextSectionsStopper=document.querySelectorAll(nextSectionStopper);for(const item of nextSections)new Waypoint({element:item,handler:function(direction){const divider=$(nextSectionDividerContent,this.element);if(direction==="down")divider.addClass('sticky');else divider.removeClass('sticky');},offset:"90%"});for(const item of nextSectionsStopper)new Waypoint({element:item,handler:function(direction){const divider=$(nextSectionDividerContent,this.element.parentElement);if(direction==="down")divider.removeClass('sticky');else divider.addClass('sticky');},offset:'90%'});},stopSidebar:function(){let previousScroll=0;const links=$('.t-navigator__sidebar .t-navigator__content .t-navigator__listItem');$(window).scroll(function(){const navigatorSidebar=$(".t-navigator__sidebar .t-navigator__content")||undefined;const navigatorContainer=$(".-navigatorContainer")||undefined;if(!navigatorSidebar||!navigatorContainer)return;let sidebarBottomOffset=navigatorSidebar.offset().top+navigatorSidebar.height();let navigatorContentOffset=navigatorContainer.offset().top+navigatorContainer.height();let currentScroll=$(this).scrollTop();let element=document.querySelector(".t-navigator__sidebar.-desktop.-wrapper .t-navigator__content");let compStyles=window.getComputedStyle(element);if(compStyles.getPropertyValue('position')=='relative'&&navigatorSidebar.offset().top<800)navigatorSidebar.css({top:`0px`});else{if(compStyles.getPropertyValue('position')=='fixed')navigatorSidebar.css({top:`70px`});}if(currentScroll>previousScroll){if(sidebarBottomOffset>=navigatorContentOffset.toFixed(0)){navigatorSidebar.removeClass("sticky");navigatorSidebar.addClass("bottomStop");const pos=navigatorContentOffset-navigatorSidebar.height()-navigatorContainer.offset().top;navigatorSidebar.css({top:`${pos-100}px`});}}else{const topOffset=navigatorSidebar.offset().top-$(window).scrollTop();const midpointActual=links.length/2;const midpointRounded=parseInt(midpointActual.toFixed(0));const elementPos=$(links[midpointRounded]).position();const isAtMidpoint=$(links[midpointRounded]).offset().top>=$(window).scrollTop();if(navigatorSidebar.hasClass("bottomStop")&&isAtMidpoint&&navigatorSidebar.hasClass('midpoint-active')){navigatorSidebar.removeClass("bottomStop");navigatorSidebar.addClass("sticky");}if(navigatorSidebar.hasClass('midpoint-active')&&!navigatorSidebar.hasClass("bottomStop"))navigatorSidebar.css({top:`-${elementPos.top-50}px`});if(navigatorSidebar.hasClass("bottomStop")&&topOffset>=50&&!navigatorSidebar.hasClass('midpoint-active')){navigatorSidebar.removeClass("bottomStop");navigatorSidebar.addClass("sticky");navigatorSidebar.css({top:`120px`});}}previousScroll=currentScroll;});},isInViewPort:function(element){const bounding=element.getBoundingClientRect();return (bounding.top>=0&&bounding.left>=0&&bounding.bottom<=(window.innerHeight||document.documentElement.clientHeight)&&bounding.right<=(window.innerWidth||document.documentElement.clientWidth));},debounce:function(func,wait,immediate){let timeout;return function(){let context=this,args=arguments;let later=function(){timeout=null;if(!immediate)func.apply(context,args);};let callNow=immediate&&!timeout;clearTimeout(timeout);timeout=setTimeout(later,wait);if(callNow)func.apply(context,args);};}};})(jQuery,Drupal);;
(function(Drupal){Drupal.behaviors.globalNav={attach:function(context,settings){const nav=context.querySelector('.o-govGlobalMenu');if(!nav)return;const mobileMenuButton=nav.querySelector('.o-govGlobalMenu__trigger');const navContainer=nav.querySelector('.o-govGlobalMenu__container');const dropdownButtons=nav.querySelectorAll('.o-govGlobalMenu__btn');const menuLabel=nav.querySelector('#nygov-menu-label');let mobileOpen=false;let closeIcon=false;mobileMenuButton.addEventListener('click',function(){mobileOpen=!mobileOpen;closeIcon=!closeIcon;if(closeIcon){navContainer.classList.add('is-visible');menuLabel.innerText='Close Menu';}else{navContainer.classList.remove('is-visible');menuLabel.innerText='Menu';}mobileMenuButton.setAttribute('aria-expanded',mobileOpen);if(closeIcon){nav.querySelector('.o-govGlobalMenu__menuIcon').classList.remove('is-active');nav.querySelector('.o-govGlobalMenu__closeIcon').classList.add('is-active');}else{nav.querySelector('.o-govGlobalMenu__menuIcon').classList.add('is-active');nav.querySelector('.o-govGlobalMenu__closeIcon').classList.remove('is-active');}});document.addEventListener('click',function(event){if(!nav.contains(event.target)){mobileOpen=false;closeIcon=false;navContainer.classList.remove('is-visible');mobileMenuButton.setAttribute('aria-expanded',mobileOpen);nav.querySelector('.o-govGlobalMenu__menuIcon').classList.add('is-active');nav.querySelector('.o-govGlobalMenu__closeIcon').classList.remove('is-active');menuLabel.innerText='Menu';}});document.addEventListener('keydown',function(event){if(event.key==='Escape'){mobileOpen=false;closeIcon=false;navContainer.classList.remove('is-visible');mobileMenuButton.setAttribute('aria-expanded',mobileOpen);nav.querySelector('.o-govGlobalMenu__menuIcon').classList.add('is-active');nav.querySelector('.o-govGlobalMenu__closeIcon').classList.remove('is-active');menuLabel.innerText='Menu';}});dropdownButtons.forEach(function(button,index){let dropdown=false;const dropdownMenu=button.nextElementSibling;button.addEventListener('click',function(){dropdown=!dropdown;button.setAttribute('aria-expanded',dropdown);dropdownMenu.style.display=dropdown?'block':'none';button.querySelector('.down-chevron').classList.toggle('icon-rotate-180',dropdown);});document.addEventListener('click',function(event){if(!button.contains(event.target)&&!dropdownMenu.contains(event.target)){dropdown=false;button.setAttribute('aria-expanded',dropdown);dropdownMenu.style.display='none';button.querySelector('.down-chevron').classList.remove('icon-rotate-180');}});document.addEventListener('keydown',function(event){if(event.key==='Escape'){dropdown=false;button.setAttribute('aria-expanded',dropdown);dropdownMenu.style.display='none';button.querySelector('.down-chevron').classList.remove('icon-rotate-180');}});});}};})(Drupal);;
