(function($,Drupal,once){Drupal.behaviors.backToTopButton={attach:function(context){const container=$(once('backToTopButton','.nygov-back-to-top',context))||undefined;if(container===undefined)return;$(container).on('click',Drupal.behaviors.backToTopButton.backToTop);$(window).on('scroll',()=>{Drupal.behaviors.backToTopButton.processScrolling(container);});},processScrolling:function(container){const scrollPoint=480;if(window.pageYOffset>scrollPoint){$(container).addClass('nygov-back-to-top-show');$(container).removeClass('nygov-back-to-top-hidden');}if(window.pageYOffset<scrollPoint){$(container).removeClass('nygov-back-to-top-show');$(container).addClass('nygov-back-to-top-hidden');}}};})(jQuery,Drupal,once);;
;
(function($,Drupal){Drupal.behaviors.heroSeparator={container:undefined,element:undefined,attach:function(context){const separator=this;if(window.innerWidth>=1280&&typeof window.TextFill==='function'){const heroTitles=document.querySelectorAll('.m-newsHero__title, .m-blogHero__title');heroTitles.forEach(function(element){window.TextFill(element,{maxFontPixels:36,innerTag:'h1',allowOverflow:true,success:function(parent){const title=parent.querySelector('h1');const wrapper=parent.closest('.m-newsHero__contentWrapper, .-blogHero');if(!title||!wrapper)return;const finalSize=parseFloat(window.getComputedStyle(title).fontSize);wrapper.classList.toggle('-textfill-adjusted',finalSize<36);}});});}const container=$('.m-separator.-wrapper.-waypoint.-anchor',context)[0]||undefined;if(container===undefined)return;const element=container.querySelector('.m-separator.-content')||undefined;if(element===undefined)return;separator.element=element;separator.container=container;window.addEventListener('scroll',separator.debounce(separator.backToTopScroll,518));separator.setWaypoints();window.addEventListener('resize',separator.debounce(separator.setWaypoints,518));},setWaypoints:function(){const separator=Drupal.behaviors.heroSeparator;if(window.innerWidth>=1280)separator.setDesktopWaypoint(separator);if(window.innerWidth<1280)separator.setMobileWayPoint(separator);},setDesktopWaypoint:function({element,container,desktopDirection}){element.classList.remove('-mobile');new Waypoint({element:container,handler:desktopDirection,group:'hero-separator'});},desktopDirection:function(direction){const separator=Drupal.behaviors.heroSeparator;if(direction==='down'){separator.element.classList.add('-stuckToTop');this.element.querySelector('.-backToTopTitle').classList.add('-opacityShow');}if(direction==='up'){separator.element.classList.remove('-stuckToTop');this.element.querySelector('.-backToTopTitle').classList.remove('-opacityShow');}},setMobileWayPoint:function({element,container,mobileDirection}){const separator=Drupal.behaviors.heroSeparator;element.classList.add('-mobile');new Waypoint({element:container,handler:mobileDirection,group:'hero-separator'});},mobileMenuHandler:function(event){const listMenu=document.querySelector('.-listMenu');const listMenuIcon=listMenu.querySelector('.fas');const navContainer=document.querySelector('.t-navigator__innerContent');const isActive=listMenuIcon.classList.contains('fa-times');const secAnchor=document.querySelector('.t-section__container.-navigator');const links=document.querySelectorAll('.t-navigator__sidebar.-mobile .t-navigator__link');const menuHeight=document.querySelector(".t-navigator__sidebar.-mobile").getBoundingClientRect().height;for(const link of links)link.addEventListener("click",(event)=>{event.preventDefault();listMenuIcon.classList.remove('fa-times');listMenuIcon.classList.add('fa-square-plus');navContainer.classList.remove('-showMenu');secAnchor.classList.remove('-anchorOpen');secAnchor.style.paddingBottom='';});if(isActive){listMenuIcon.classList.remove('fa-times');listMenuIcon.classList.add('fa-square-plus');navContainer.classList.remove('-showMenu');secAnchor.classList.remove('-anchorOpen');listMenu.setAttribute('aria-expanded',false);secAnchor.style.paddingBottom='';}else{listMenuIcon.classList.add('fa-times');listMenuIcon.classList.remove('fa-square-plus');navContainer.classList.add('-showMenu');secAnchor.classList.add('-anchorOpen');listMenu.setAttribute('aria-expanded',true);secAnchor.style.paddingBottom=menuHeight+'px';}},mobileDirection:function(direction){const separator=Drupal.behaviors.heroSeparator;const listMenu=document.querySelector('.-listMenu');const listMenuIcon=listMenu.querySelector('.fas');const navContainer=document.querySelector('.t-navigator__innerContent');const secAnchor=document.querySelector('.t-section__container.-navigator');listMenu.addEventListener('click',separator.mobileMenuHandler);if(navContainer){if(direction==='down'){separator.element.classList.add('-stuckToTop');this.element.querySelector('.-backToTopTitle').classList.add('-show');}if(direction==='up'){separator.element.classList.remove('-stuckToTop');this.element.querySelector('.-backToTopTitle').classList.remove('-show');navContainer.classList.remove('-showMenu');listMenuIcon.classList.remove('fa-times');listMenuIcon.classList.add('fa-square-plus');secAnchor.classList.remove('-anchorOpen');secAnchor.style.paddingBottom='';listMenu.setAttribute('aria-expanded',false);}}},debounce:function(func,wait,immediate){let timeout;return function(){let context=this,args=arguments;let later=function(){timeout=null;if(!immediate)func.apply(context,args);};let callNow=immediate&&!timeout;clearTimeout(timeout);timeout=setTimeout(later,wait);if(callNow)func.apply(context,args);};}};})(jQuery,Drupal);;
(function($,Drupal){Drupal.behaviors.navigatorSidebar={navClasses:{sidebar:".t-navigator__sidebar",contentArea:".t-navigator__content",sidebarDesktop:".t-navigator__sidebar.-desktop",activeMenuItem:".t-navigator__sidebar.-desktop .t-navigator__listItem.active",contentTopWaypoint:".t-section__topWaypoint",contentBottomWaypoint:".t-section__bottomWaypoint",nextSection:".-navigatorContainer .m-nextSection__divider",nextSectionDividerContent:".m-nextSection__dividerContent",arrow:".t-navigator__sidebar.-desktop .t-navigator__arrow",sidebarLinks:".t-navigator__sidebar.-desktop .t-navigator__link",nextSectionBottom:".t-section__container.-navigator .m-nextSection__dividerContent .m-nextSection__bottom",nextSectionContinue:".t-section__container.-navigator .m-nextSection__dividerContent .m-nextSection__continue",sidebarDesktop:".t-navigator__sidebar.-desktop",contendArea:".t-navigator__content",firstLink:".t-navigator__sidebar.-desktop .t-navigator__listItem.first",desktopMenuLinks:".t-navigator__sidebar.-desktop .t-navigator__link",nextSection:".m-nextSection",nextSectionDividerContent:".m-nextSection__dividerContent",activeLink:'.t-navigator__sidebar.-desktop .t-navigator__listItem.active',nextSectionStopper:".t-section__container.-navigator .m-nextSection__dividerContentStopper",mobileMenu:".t-navigator__sidebar.-mobile",mobileMenuWaypoint:".t-navigator__sidebarWaypoint.-mobile",menuIcons:".t-navigator__menuIcons",menuLinks:".t-navigator__link",mobileMenuLinks:".t-navigator__sidebar.-mobile .t-navigator__link",mobileActiveMenuItem:".t-navigator__sidebar.-mobile .t-navigator__listItem.active",anchorElements:".t-section__anchor",open:"-opened",close:"-closed"},attach:function(context){const navigator=$(this.navClasses.sidebar,context)[0]||undefined;const navigatorContainer=$('.-navigatorContainer')||undefined;if(navigator===undefined||navigatorContainer===undefined)return;const activeItem=document.querySelector(this.navClasses.activeMenuItem);const nav=this;document.query